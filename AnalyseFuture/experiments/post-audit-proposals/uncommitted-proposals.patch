+// This optional backend has no production identity verifier yet. Fail closed
+// for every mutation, including legacy upload/delete/AI and crash endpoints;
+// CORS or caller-supplied identity headers must never authorize a write.
+app.use('/*', async (c, next) => {
+  if (!['GET', 'HEAD', 'OPTIONS'].includes(c.req.method)) {
+    const identity = requireUser(c);
+    if (isResponse(identity)) return identity;
+  }
+  await next();
+});
+
 // Marketplace + Studio API (STUDIO_PLAN §34), mounted under /v1.
 app.route('/v1', marketplace);
 app.route('/v1', studio);
